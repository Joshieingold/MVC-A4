@model List<A4_EF_CRUD_Validation.Models.Course>
<div class="d-flex flex-row justify-content-between align-items-center">
    <h2>All Courses</h2>
    <a action="submit" asp-action="Create" class="btn btn-primary bi bi-plus-lg"></a>
</div>

<table class="table">
    <tr>
        <th>Course Name:</th>
        <th>Instructor</th>
        <th>Credits</th>
        <th>Online</th>
        <th>Actions</th>
    </tr>
    @foreach (Course item in @Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Instructor</td>
            <td>@item.Credits</td>
            <td>@item.Online</td>
            <td class="d-flex gap-1">
                <form>
                    <input type="hidden" value="@item.Id" name="id" />
                    <i asp-action="Details" asp-route-id="@item.Id" class="btn btn-info bi bi-info-square text-white"></i>
                    <i asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary bi bi-pencil"></i>
                    <i asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger bi bi-trash"></i>
                </form>
            </td>
        </tr>
    }
</table>

